{
  "name": "@sihsalus/esm-epidemiological-surveillance",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "description": "OpenMRS ESM Epidemiological Surveillance starter microfrontend for SIH Salus",
  "browser": "dist/sihsalus-esm-epidemiological-surveillance.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "yarn serve",
    "build": "rspack --mode=production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "node ../../tooling/scripts/run-biome.js lint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "typescript": "tsc --noEmit",
    "extract-translations": "i18next 'src/**/*.{ts,tsx}' '!src/**/*.test.{ts,tsx}' '!src/**/*.spec.{ts,tsx}' --config ../../tooling/scripts/i18next-parser.config.js"
  },
  "files": [
    "dist",
    "src",
    "translations"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "sihsalus",
    "epidemiological-surveillance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sihsalus/esm-rbac": "workspace:*"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@openmrs/esm-framework": "*",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": ">=6.30.4 <8",
    "rxjs": "6.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "workspace:*",
    "@rspack/cli": "1.7.11",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "openmrs": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
