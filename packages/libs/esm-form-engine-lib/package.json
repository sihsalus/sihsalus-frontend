{
  "name": "@sihsalus/esm-form-engine-lib",
  "version": "4.1.0",
  "description": "React Form Engine for O3",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/setup-tests.ts",
    "!src/utils/test-utils.ts",
    "!src/zscore-tests",
    "README.md",
    "LICENSE.txt",
    "readme"
  ],
  "license": "MIT",
  "homepage": "https://github.com/openmrs/openmrs-esm-form-engine-lib#readme",
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "lint": "node ../../tooling/scripts/run-biome.js lint src",
    "test": "vitest run --passWithNoTests",
    "typescript": "tsc --noEmit",
    "build": "rimraf dist && swc --strip-leading-paths --copy-files --ignore '**/*.test.*' --ignore '**/setup-tests.*' --ignore '**/test-utils.*' src -d dist && tsc --project tsconfig.build.json",
    "extract-translations": "i18next-cli extract --config ../../tooling/scripts/i18next.config.mjs"
  },
  "dependencies": {
    "@carbon/react": "^1.118.0",
    "@openmrs/esm-utils": "workspace:*",
    "classnames": "^2.5.1",
    "jsep": "^1.6.0",
    "lodash-es": "^4.17.21",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-waypoint": "^10.3.0"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "workspace:*",
    "@openmrs/esm-styleguide": "workspace:*",
    "dayjs": "1.x",
    "i18next": "26.x",
    "react": "18.x",
    "react-i18next": "17.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/esm-framework": "workspace:*",
    "@openmrs/esm-styleguide": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.18",
    "@types/lodash": "^4.17.26",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "dayjs": "^1.11.23",
    "husky": "^8.0.3",
    "i18next": "^26.4.7",
    "i18next-cli": "1.75.3",
    "lint-staged": "^17.6.0",
    "openmrs": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^5.0.0",
    "sass": "^1.105.2",
    "swr": "^2.5.1",
    "turbo": "^2.11.9",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
