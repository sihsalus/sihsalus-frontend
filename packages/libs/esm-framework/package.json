{
  "name": "@openmrs/esm-framework",
  "version": "10.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./mock": {
      "import": "./mock.tsx",
      "require": "./mock-vitest.tsx"
    },
    "./mock.tsx": {
      "import": "./mock.tsx",
      "require": "./mock-vitest.tsx"
    }
  },
  "source": true,
  "scripts": {
    "document": "typedoc",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "build": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "build:development": "rimraf dist && concurrently \"swc --strip-leading-paths src -d dist\" \"tsc --project tsconfig.build.json\"",
    "typescript": "tsc --project tsconfig.build.json --noEmit",
    "lint": "node ../../tooling/scripts/run-biome.js lint ."
  },
  "keywords": [
    "openmrs",
    "framework",
    "frontend",
    "ui",
    "microfrontends"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmrs/openmrs-esm-core.git"
  },
  "bugs": {
    "url": "https://github.com/openmrs/openmrs-esm-core/issues"
  },
  "homepage": "https://github.com/openmrs/openmrs-esm-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openmrs/esm-api": "workspace:*",
    "@openmrs/esm-config": "workspace:*",
    "@openmrs/esm-context": "10.0.0",
    "@openmrs/esm-dynamic-loading": "workspace:*",
    "@openmrs/esm-emr-api": "workspace:*",
    "@openmrs/esm-error-handling": "workspace:*",
    "@openmrs/esm-expression-evaluator": "workspace:*",
    "@openmrs/esm-extensions": "workspace:*",
    "@openmrs/esm-feature-flags": "workspace:*",
    "@openmrs/esm-globals": "workspace:*",
    "@openmrs/esm-navigation": "workspace:*",
    "@openmrs/esm-offline": "workspace:*",
    "@openmrs/esm-react-utils": "workspace:*",
    "@openmrs/esm-routes": "workspace:*",
    "@openmrs/esm-state": "workspace:*",
    "@openmrs/esm-styleguide": "workspace:*",
    "@openmrs/esm-translations": "workspace:*",
    "@openmrs/esm-utils": "workspace:*"
  },
  "peerDependencies": {
    "dayjs": "1.x",
    "i18next": "26.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "17.x",
    "rxjs": "6.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@openmrs/typedoc-plugin-file-categories": "10.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@types/fhir": "0.0.31",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "happy-dom": "^20.14.5",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "stableVersion": "10.0.0"
}
