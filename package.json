    "flatted": "3.4.2",
    "http-proxy-middleware": "3.0.7",
    "immutable": "5.1.8",
    "js-yaml": "4.3.2",
    "linkify-it": "5.0.2",
    "piscina": "^4.9.4",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "tar": "7.5.22",
    "undici": "7.29.1",
    "vite": "8.3.2",
    "ws": "8.21.0",
    "webpack-dev-server": "5.2.6",
    "postcss": "8.5.23",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "sigstore": "4.1.1",
    "smol-toml": "1.7.1",
    "uuid": "14.0.2",
    "uuid@npm:^8.3.2": "npm:14.0.2",
    "uuid@npm:^9.0.1": "npm:14.0.2",
    "phin@npm:^2.9.1": "npm:3.7.1",
    "brace-expansion@npm:^1.1.7": "patch:brace-expansion@npm%3A5.0.12#~/.yarn/patches/brace-expansion-npm-5.0.12-compat.patch",
    "brace-expansion@npm:^2.0.1": "patch:brace-expansion@npm%3A5.0.12#~/.yarn/patches/brace-expansion-npm-5.0.12-compat.patch",
    "brace-expansion@npm:^2.0.2": "patch:brace-expansion@npm%3A5.0.12#~/.yarn/patches/brace-expansion-npm-5.0.12-compat.patch",
    "brace-expansion@npm:^5.0.2": "patch:brace-expansion@npm%3A5.0.12#~/.yarn/patches/brace-expansion-npm-5.0.12-compat.patch",
    "brace-expansion@npm:^5.0.5": "patch:brace-expansion@npm%3A5.0.12#~/.yarn/patches/brace-expansion-npm-5.0.12-compat.patch",
    "browserslist": "4.28.8",
    "extend@npm:~1.2.1": "npm:3.0.2",
    "turbo@npm:^2.5.2": "npm:2.11.4",
    "turbo@npm:^2.9.1": "npm:2.11.4",
