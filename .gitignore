!.yarn/patches
!.yarn/plugins
!.yarn/sdks
.pnp.*
yarn.lock.backup

# TypeScript build artifacts in libs src/
packages/libs/*/src/**/*.js
packages/libs/*/src/**/*.d.ts
packages/libs/*/src/**/*.js.map
packages/libs/*/src/**/*.d.ts.map

# Playwright
e2e/storage-state.json
test-results/
