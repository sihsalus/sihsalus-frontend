{
  "name": "@sihsalus/sihsalus-esm",
  "version": "1.1.2",
  "private": true,
  "author": {
    "name": "Pontificia Universidad Catolica del Peru (PUCP) - Grupo de Investigacion y Desarrollo de Ingenieria de Software (GIDIS)",
    "email": "gonzalo.galvezc@pucp.edu.pe"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/apps/*",
    "packages/libs/*",
    "packages/tooling/*"
  ],
  "scripts": {
    "start": "node packages/tooling/scripts/start-dev.js",
    "build": "node node_modules/turbo/bin/turbo run build",
    "build:apps": "node node_modules/turbo/bin/turbo run build --filter='./packages/apps/*'",
    "assemble": "node packages/tooling/scripts/generate-assemble-config.js && node packages/tooling/scripts/assemble-importmap.js && node packages/tooling/scripts/validate-spa-artifact.js",
    "package:spa": "yarn build:apps && yarn assemble",
    "serve": "openmrs start",
    "serve:prod": "yarn build:apps && yarn assemble && openmrs start",
    "test": "cross-env TZ=UTC node node_modules/turbo/bin/turbo run test --concurrency=2",
    "test:e2e:suite": "node e2e/scripts/run-suite.mjs",
    "test:e2e:contracts": "yarn typecheck:e2e && yarn test:e2e:unit && yarn test:e2e:catalog",
    "test:e2e:catalog": "node --test packages/tooling/scripts/e2e-suite-catalog.test.js",
    "test:e2e:unit": "vitest run e2e/utils --environment node",
    "test:e2e:offline-laptop:unit": "vitest run e2e/offline-laptop/gate-config.test.ts e2e/offline-laptop/synthetic-patient-cleanup.test.ts e2e/offline-laptop/evidence-sanitization.test.ts --environment node",
    "build:e2e:offline-local": "yarn build --filter=@openmrs/esm-offline... --concurrency=2",
    "format": "biome format --write .",
    "lint": "node node_modules/turbo/bin/turbo run lint",
    "lint:all": "biome lint .",
    "test:tooling": "node --test \"packages/tooling/scripts/*.test.js\"",
    "test:styles": "yarn workspace @openmrs/rspack-config build && node --test packages/tooling/scripts/styles.browser.spec.js",
    "security:audit": "yarn validate:react-router && node packages/tooling/scripts/audit-patched-dependencies.js",
    "validate:concepts": "node packages/tooling/scripts/validate-concept-existence.js",
    "validate:error-exposure": "node packages/tooling/scripts/validate-error-exposure.js",
    "validate:critical-route-privileges": "node packages/tooling/scripts/validate-critical-route-privileges.js",
    "validate:react-router": "node packages/tooling/scripts/validate-react-router-contract.js",
    "validate:lint-coverage": "node packages/tooling/scripts/validate-lint-coverage.js",
    "validate:test-governance": "node packages/tooling/scripts/validate-test-governance.js",
    "validate:workspaces": "node packages/tooling/scripts/audit-workspaces.js && node packages/tooling/scripts/validate-fhir-dependencies.js",
    "benchmark:typescript": "node packages/tooling/scripts/benchmark-typescript.js",
    "typecheck": "node node_modules/turbo/bin/turbo run typescript",
    "typecheck:e2e": "yarn build:e2e:offline-local && tsc -p e2e/tsconfig.json && tsc -p e2e/offline-local/tsconfig.browser.json",
    "verify": "cross-env TZ=UTC node node_modules/turbo/bin/turbo run lint typescript && cross-env TZ=UTC node node_modules/turbo/bin/turbo run test --concurrency=2",
    "verify:changed": "node packages/tooling/scripts/verify-changed.js",
    "extract-translations": "node node_modules/turbo/bin/turbo run extract-translations",
    "knip": "knip",
    "sihsalus:doctor": "node packages/tooling/scripts/sihsalus-doctor.js",
    "clean": "node packages/tooling/scripts/clean-monorepo.js",
    "prepare": "husky",
    "test:form-builder-browser": "yarn workspace @openmrs/rspack-config build && node --test packages/tooling/scripts/form-builder.browser.spec.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@openmrs/esm-offline": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@swc/core": "1.16.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fhir": "0.0.31",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "5.0.3",
    "acorn": "8.18.0",
    "chalk": "^4.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint-scope": "9.1.2",
    "express": "^4.22.0",
    "express-rate-limit": "8.7.0",
    "fake-indexeddb": "^4.0.2",
    "happy-dom": "^20.14.5",
    "http-proxy-middleware": "3.0.7",
    "husky": "^9.1.7",
    "i18next-parser": "^9.3.0",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "openmrs": "workspace:*",
    "pacote": "^21.0.1",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-doctor": "^0.9.14",
    "react-dom": "^18.3.1",
    "swc-loader": "0.2.7",
    "turbo": "2.11.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "7.29.1",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "lint-staged": {
    "*.{css,js,json,tsx}": "biome check --write",
    "!(*.d).ts": "biome check --write",
    "*.scss": "prettier --write"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@openmrs/esm-app-shell/i18next": "26.4.2",
    "@openmrs/esm-app-shell/react-i18next": "17.0.11",
    "file-type": "npm:^21.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@rspack/core": "2.2.8",
    "@rspack/cli": "2.2.8",
    "@babel/core": "7.29.6",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "sass": "1.105.0",
    "zustand": "^4.5.5",
    "html-webpack-plugin": "^5.5.0",
    "swr": "2.5.1",
    "cross-env": "^10.1.0",
    "@carbon/styles": "^1.116.0",
    "fast-uri": "3.1.8",
    "form-data": "^4.0.5",
    "picomatch": "^4.0.4",
