{
  "name": "@sihsalus/esm-blood-bank-app",
  "version": "1.0.0-alpha",
  "description": "Microfrontend de Banco de Sangre para SIH Salus",
  "browser": "dist/sihsalus-esm-blood-bank-app.js",
  "main": "src/index.ts",
  "source": true,
  "license": "MPL-2.0",
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "yarn serve",
    "build": "rspack --mode=production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "node ../../tooling/scripts/run-biome.js lint .",
    "typescript": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "extract-translations": "i18next 'src/**/*.{ts,tsx}' '!src/**/*.test.{ts,tsx}' '!src/**/*.spec.{ts,tsx}' --config ../../tooling/scripts/i18next-parser.config.js"
  },
  "files": [
    "dist",
    "src",
    "translations"
  ],
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "sihsalus",
    "blood-bank"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sihsalus/esm-rbac": "workspace:*"
  },
  "peerDependencies": {
    "@carbon/react": "1.x",
    "@carbon/styles": "1.x",
    "@openmrs/esm-framework": "*",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "17.x",
    "react-router-dom": ">=6.30.4 <8",
    "rxjs": "6.x"
  },
  "devDependencies": {
    "@carbon/react": "^1.117.0",
    "@carbon/styles": "^1.116.0",
    "@openmrs/esm-framework": "workspace:*",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "css-loader": "7.1.5",
    "openmrs": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "7.18.4",
    "rxjs": "^6.6.7",
    "sass-embedded": "1.105.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "vitest": "5.0.3"
  }
}
