    "serialize-javascript": "^7.0.5",
    "ip-address": "^10.7.1",
    "ip": "npm:ip@2.0.1",
    "qs": "^6.16.0",
    "socks": "^2.8.7",
    "prismjs": "^1.30.0",
    "tmp": "^0.2.6",
