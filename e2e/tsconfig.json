{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "global-setup.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "offline-laptop/**/*.ts",
    "cohort-builder/**/*.ts",
    "dyaku/**/*.ts",
    "patient-imaging/**/*.ts",
    "stock-management/**/*.ts",
    "user-onboarding/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
