    "@openmrs/esm-app-shell@npm:9.0.2": "patch:@openmrs/esm-app-shell@npm%3A9.0.2#./.yarn/patches/openmrs-esm-app-shell-npm-9.0.2-source-build.patch",
    "@openmrs/esm-offline": "workspace:*",
    "@openmrs/esm-styleguide": "workspace:*",
