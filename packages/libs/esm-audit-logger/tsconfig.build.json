  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "rootDir": "src",
    "moduleResolution": "bundler",
    "isolatedModules": false,
    "incremental": false,
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.*"]
}
