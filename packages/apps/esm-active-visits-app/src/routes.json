{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "webservices.rest": ">=2.2.0"
  },
  "extensions": [
    {
      "name": "active-visits-widget",
      "slot": "homepage-widgets-slot",
      "component": "activeVisits",
      "privileges": "app:home.tabla.consultas.activas",
      "order": 0
    },
    {
      "name": "pending-sis-accreditations-widget",
      "slot": "homepage-widgets-slot",
      "component": "pendingSisAccreditations",
      "privileges": "app:home.admision",
      "order": 2
    },
    {
      "name": "pending-sis-accreditations-tile",
      "slot": "home-metrics-tiles-slot",
      "component": "homePendingSisAccreditationsTile",
      "privileges": "app:home.admision",
      "order": 2
    },
    {
      "name": "visit-summary-widget",
      "slot": "visit-summary-slot",
      "component": "visitDetail",
      "privileges": "app:hoja.clinica"
    },
    {
      "name": "active-visits-tile",
      "slot": "home-metrics-tiles-slot",
      "component": "homeActiveVisitsTile",
      "privileges": "app:home.tabla.consultas.activas"
    },
    {
      "name": "total-visits-tile",
      "slot": "home-metrics-tiles-slot",
      "component": "homeTotalVisitsTile",
      "privileges": "app:home.tabla.consultas.activas"
    },
    {
      "name": "my-attentions-app-menu-item",
      "slot": "app-menu-slot",
      "component": "myAttentionsLink",
      "privileges": ["Get Encounters", "Get Patients", "Get Visits"],
      "online": true,
      "offline": false
    },
    {
      "name": "my-attentions-home-dashboard-link",
      "slot": "homepage-dashboard-slot",
      "component": "myAttentionsLink",
      "privileges": ["Get Encounters", "Get Patients", "Get Visits"],
      "meta": {
        "name": "my-attentions",
        "slot": "my-attentions-dashboard-slot",
        "title": "myAttentions",
        "path": "/home/my-attentions"
      },
      "online": true,
      "offline": false
    },
    {
      "name": "my-attentions-home-dashboard",
      "slot": "my-attentions-dashboard-slot",
      "component": "myAttentions",
      "privileges": ["Get Encounters", "Get Patients", "Get Visits"],
      "online": true,
      "offline": false
    }
  ],
  "pages": []
}
