{
  "name": "@sihsalus/esm-cred-app",
  "version": "1.0.10",
  "description": "Módulo CRED - Control de Crecimiento y Desarrollo del Niño - OpenMRS O3",
  "browser": "dist/sihsalus-esm-cred-app.js",
  "main": "src/index.ts",
  "source": true,
  "license": "MPL-2.0",
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "yarn serve",
    "build": "rspack --mode=production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "node ../../tooling/scripts/run-biome.js lint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typescript": "tsc --noEmit",
    "extract-translations": "i18next 'src/**/*.{ts,tsx}' '!src/**/*.test.{ts,tsx}' '!src/**/*.spec.{ts,tsx}' --config ../../tooling/scripts/i18next-parser.config.js"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "sihsalus",
    "cred"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/sihsalus/sihsalus-esm-modules#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sihsalus/sihsalus-esm-modules.git"
  },
  "bugs": {
    "url": "https://github.com/sihsalus/sihsalus-esm-modules/issues"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.20",
    "@carbon/charts-react": "^1.27.20",
    "@hookform/resolvers": "^5.9.1",
    "@openmrs/esm-utils": "workspace:*",
    "@sihsalus/esm-rbac": "workspace:*",
    "classnames": "^2.5.1",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@carbon/colors": "11.x",
    "@carbon/layout": "11.x",
    "@carbon/react": "1.x",
    "@carbon/styles": "1.x",
    "@openmrs/esm-framework": "*",
    "@openmrs/esm-patient-common-lib": "*",
    "dayjs": "1.x",
    "react": "18.x",
    "react-i18next": "17.x",
    "react-is": "19.x",
    "react-router-dom": ">=6.30.4 <8",
    "rxjs": "6.x",
    "single-spa": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "@carbon/colors": "^11.59.0",
    "@carbon/layout": "^11.60.0",
    "@carbon/react": "^1.117.0",
    "@carbon/styles": "^1.116.0",
    "@openmrs/esm-framework": "workspace:*",
    "@openmrs/esm-patient-common-lib": "workspace:*",
    "@rspack/cli": "2.2.8",
    "@rspack/core": "2.2.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "openmrs": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-is": "^19.3.0",
    "react-router-dom": "7.18.4",
    "rxjs": "^7.8.2",
    "sass": "^1.105.1",
    "single-spa": "^6.0.3",
    "swr": "^2.5.1",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  }
}
